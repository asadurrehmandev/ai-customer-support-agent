# Copy to backend/.env or export these. Leave the model keys empty for Demo mode.

KEEL_DATABASE_URL=sqlite:///./data/keel.db
KEEL_SKIP_TRAFFIC=0
KEEL_REFUND_THRESHOLD_CENTS=7500

# Optional live store adapters. Unset means the local SQLite shop is used.
KEEL_SHOPIFY_SHOP=
KEEL_SHOPIFY_TOKEN=
KEEL_STRIPE_API_KEY=

# Optional Zendesk. Unset means tickets stay in the Keel inbox.
KEEL_ZENDESK_SUBDOMAIN=
KEEL_ZENDESK_EMAIL=
KEEL_ZENDESK_API_TOKEN=

# Optional server-side model. A key pasted in the dashboard is not written here.
KEEL_ANTHROPIC_API_KEY=
KEEL_OPENAI_API_KEY=
KEEL_ANTHROPIC_MODEL=claude-sonnet-4-5
KEEL_OPENAI_MODEL=gpt-4o-mini

FASTEMBED_CACHE_PATH=../.cache/fastembed
